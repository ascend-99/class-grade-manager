<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>知衡 · 班级学生成绩管理系统</display-name>

    <listener>
        <listener-class>com.zhihang.grade.web.listener.AppLifecycleListener</listener-class>
    </listener>

    <filter>
        <filter-name>ErrorLogFilter</filter-name>
        <filter-class>com.zhihang.grade.web.filter.ErrorLogFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>ErrorLogFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.zhihang.grade.web.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>FlashFilter</filter-name>
        <filter-class>com.zhihang.grade.web.filter.FlashFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FlashFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.zhihang.grade.web.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ClassServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.ClassServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ClassServlet</servlet-name>
        <url-pattern>/classes</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StudentServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.StudentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentServlet</servlet-name>
        <url-pattern>/students</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CourseServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.CourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CourseServlet</servlet-name>
        <url-pattern>/courses</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GradeServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.GradeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GradeServlet</servlet-name>
        <url-pattern>/grades</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EntryServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.EntryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EntryServlet</servlet-name>
        <url-pattern>/entry</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GradeTemplateServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.GradeTemplateServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GradeTemplateServlet</servlet-name>
        <url-pattern>/entry/template</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GradeImportServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.GradeImportServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>GradeImportServlet</servlet-name>
        <url-pattern>/entry/import</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GradeHistoryServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.GradeHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GradeHistoryServlet</servlet-name>
        <url-pattern>/grade-history</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AnalyticsServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.AnalyticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AnalyticsServlet</servlet-name>
        <url-pattern>/analytics</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ExportServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.ExportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ExportServlet</servlet-name>
        <url-pattern>/export</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PortalServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.PortalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PortalServlet</servlet-name>
        <url-pattern>/portal</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PortalGradesServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.PortalGradesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PortalGradesServlet</servlet-name>
        <url-pattern>/portal/grades</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.zhihang.grade.web.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>60</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>
</web-app>
