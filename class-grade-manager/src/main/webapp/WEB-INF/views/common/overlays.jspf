<div class="confirm-backdrop" id="confirmDialog" aria-hidden="true">
    <div class="confirm-box" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <div class="confirm-icon">
            <svg class="icon"><use href="#i-trash"></use></svg>
        </div>
        <h3 id="confirmTitle">确认执行此操作？</h3>
        <p id="confirmMessage">此操作完成后可能无法撤销，请确认。</p>
        <div class="confirm-actions">
            <button type="button" class="btn btn-ghost" id="confirmCancel">先不操作</button>
            <button type="button" class="btn btn-danger-ghost" id="confirmSubmit">确认删除</button>
        </div>
    </div>
</div>
